__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Default output dir of scripts/render_handbook_artifact.py
test-reports/

# Default output dir of scripts/build_python_fixtures.py. The seeded fixture
# trees are generated, and each one is its own git repository - committing them
# would nest a repository inside this one and freeze a resolution that the pins
# in scripts/python_fixture_spec.py are the real record of. Rebuild them rather
# than reading them from history.
fixtures/

# Where a sweep against an audit target writes its report, findings JSON, baseline
# diff and emitter dry run. Those files carry the target's file paths and package
# name, which no tracked file here may carry: this repository names no other
# project in its own organisation or its origin's. They stay on the host that ran
# the sweep; the pull request carries counts and placeholder terms instead.
sweeps/

# Default output dir of scripts/render_handbook_book.py
build/

# macOS Finder metadata
.DS_Store
